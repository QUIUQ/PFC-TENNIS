; =========================
; PFC2D tennis: one-bounce then hit
; 目标：球先在地面弹跳一次，再由右侧球拍击球
; =========================

model new
model large-strain on
model domain extent -2 14 -1 6
model gravity 0 -9.81

; -------------------------
; random seed: slightly varied initial speed
; -------------------------
fish define init_random
    global vx0 = 5.5 + 1.5 * math.random.uniform
    global vy0 = -0.8 - 0.8 * math.random.uniform
end
@init_random

; -------------------------
; ball
; -------------------------
ball create id 1 radius 0.15 position 2.0 1.8
ball attribute density 60 damp 0.005
ball attribute velocity [vx0] [vy0]

; -------------------------
; contact model
; -------------------------
contact cmat default model linear method deformability emod 1e6 kratio 1.5
contact cmat default property fric 0.08

; -------------------------
; boundaries and objects
; -------------------------
wall create id 1 vertices -2 0 14 0
wall create id 2 vertices 6 0 6 1.1
wall create id 3 vertices 1 0.5 1 2.8
wall create id 4 vertices 11 0.5 11 2.8

; -------------------------
; bounce tracking:
; detect first ground bounce by velocity sign change near ground
; -------------------------
fish define init_state
    global bounce_count = 0
    global prev_vy = ball.vel.y(ball.find(1))
    global hit_done = 0
end
@init_state

fish define detect_bounce
    local by = ball.pos.y(ball.find(1))
    local vy = ball.vel.y(ball.find(1))

    ; near ground and vertical velocity turns from down to up => one bounce
    if bounce_count = 0 then
        if by < 0.22 then
            if prev_vy < 0.0 then
                if vy > 0.0 then
                    bounce_count = 1
                endif
            endif
        endif
    endif

    prev_vy = vy
end

; -------------------------
; racket control
; only hit after the first bounce
; -------------------------
fish define racket_motion
    local bx = ball.pos.x(ball.find(1))

    ; stop rackets by default
    wall.vel.x(wall.find(3)) = 0.0
    wall.vel.y(wall.find(3)) = 0.0
    wall.vel.x(wall.find(4)) = 0.0
    wall.vel.y(wall.find(4)) = 0.0

    ; keep left racket passive in this scenario

    ; right racket hits only after one bounce and ball arrives near racket zone
    if bounce_count >= 1 then
        if bx > 9.8 then
            if hit_done = 0 then
                wall.vel.x(wall.find(4)) = -9.0
                wall.vel.y(wall.find(4)) = 1.8
                hit_done = 1
            endif
        endif
    endif
end

fish callback add detect_bounce -1.0
fish callback add racket_motion -1.0

; -------------------------
; stop condition
; -------------------------
fish define check_stop
    global stop_flag

    local bx = ball.pos.x(ball.find(1))
    local by = ball.pos.y(ball.find(1))

    stop_flag = 0

    ; side boundaries
    if bx < -1.8 then
        stop_flag = 1
    endif
    if bx > 13.8 then
        stop_flag = 1
    endif

    ; too close to bottom after the bounce-hit sequence
    if by < 0.12 then
        if bounce_count >= 1 then
            stop_flag = 1
        endif
    endif

    ; hit net
    if bx > 5.85 then
        if bx < 6.15 then
            if by < 1.25 then
                stop_flag = 1
            endif
        endif
    endif
end

; -------------------------
; slow animation loop
; -------------------------
fish define slow_run
    global stop_flag = 0
    local i = 0

    loop while i < 3500

        command
            model cycle 40
        endcommand

        check_stop

        if stop_flag = 1 then
            i = 3500
        endif

        i = i + 1

    endloop
end

@slow_run
